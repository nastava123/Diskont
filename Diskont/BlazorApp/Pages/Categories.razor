@page "/categories"
@inject HttpClient Http

<h1>Kategorije</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="mb-3">
    <input class="form-control d-inline-block w-auto" placeholder="Naziv kategorije"
           @bind="name" />

    @if (editId == 0)
    {
        <button class="btn btn-primary" @onclick="AddAsync">Dodaj</button>
    }
    else
    {
        <button class="btn btn-success" @onclick="SaveAsync">Sačuvaj</button>
        <button class="btn btn-secondary" @onclick="Cancel">Otkaži</button>
    }
</div>

@if (categories == null)
{
    <p>Učitavanje...</p>
}
else
{
    <table class="table">
        <tr>
            <th>ID</th>
            <th>Naziv</th>
            <th></th>
        </tr>
        @foreach (Category c in categories)
        {
            <tr>
                <td>@c.IdCategory</td>
                <td>@c.Name</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => Edit(c)">Izmeni</button>
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => DeleteAsync(c.IdCategory)">Obriši</button>
                </td>
            </tr>
        }
    </table>
}

@code {
    private List<Category>? categories;
    private string name = "";           // tekst iz polja za unos
    private int editId = 0;             // 0 = dodavanje, inače ID kategorije za izmenu
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        categories = await Http.GetFromJsonAsync<List<Category>>("api/categories");
    }

    private async Task AddAsync()
    {
        Category category = new Category { Name = name };
        HttpResponseMessage response =
            await Http.PostAsJsonAsync("api/categories", category);
        await HandleResponseAsync(response);
    }

    private void Edit(Category c)
    {
        editId = c.IdCategory;
        name = c.Name ?? "";
    }

    private async Task SaveAsync()
    {
        Category category = new Category { IdCategory = editId, Name = name };
        HttpResponseMessage response =
            await Http.PutAsJsonAsync($"api/categories/{editId}", category);
        await HandleResponseAsync(response);
    }

    private void Cancel()
    {
        editId = 0;
        name = "";
    }

    private async Task DeleteAsync(int id)
    {
        HttpResponseMessage response =
            await Http.DeleteAsync($"api/categories/{id}");
        await HandleResponseAsync(response);
    }

    // posle svake izmene: uspeh -> očisti formu i učitaj ponovo,
    //                     greška -> prikaži poruku iz Web API-ja
    private async Task HandleResponseAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            errorMessage = null;
            Cancel();
            await LoadAsync();
        }
        else
        {
            ErrorResponse? error =
                await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = error?.Message;
        }
    }
}
