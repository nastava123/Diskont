@page "/categories"
@inject CategoryApi CategoryApi
@inject IJSRuntime JS

<PageTitle>Kategorije</PageTitle>

<h1>Kategorije</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}

<EditForm Model="form" OnSubmit="SaveAsync" class="row g-2 mb-4">
    <div class="col-sm-6 col-lg-4">
        <InputText @bind-Value="form.Name" class="form-control"
                   placeholder="Naziv kategorije" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            @(form.IdCategory == 0 ? "Dodaj" : "Sačuvaj izmene")
        </button>
        @if (form.IdCategory != 0)
        {
            <button type="button" class="btn btn-outline-secondary ms-1"
                    @onclick="CancelEdit">Otkaži</button>
        }
    </div>
</EditForm>

@if (categories == null)
{
    <p><em>Učitavanje...</em></p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 80px">ID</th>
                <th>Naziv</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Category category in categories)
            {
                <tr class="@RowClass(category)">
                    <td>@category.IdCategory</td>
                    <td>@category.Name</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => Edit(category)">Izmeni</button>
                        <button class="btn btn-sm btn-outline-danger ms-1"
                                @onclick="() => DeleteAsync(category)">Obriši</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Category>? categories;
    private Category form = new Category();     // IdCategory == 0: nova kategorija
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            categories = await CategoryApi.GetAllAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Web API nije dostupan. Da li je pokrenut WebApi?";
        }
    }

    private async Task SaveAsync()
    {
        ClearMessages();
        try
        {
            if (form.IdCategory == 0)
            {
                await CategoryApi.AddAsync(form);
                successMessage = $"Kategorija „{form.Name}” je dodata.";
            }
            else
            {
                await CategoryApi.UpdateAsync(form);
                successMessage = $"Kategorija „{form.Name}” je izmenjena.";
            }

            form = new Category();              // prazna forma za sledeći unos
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;          // poruka iz BusinessLayer-a, npr. 409
        }
    }

    private void Edit(Category category)
    {
        ClearMessages();
        // kopija: dok korisnik kuca, red u tabeli se ne menja
        form = new Category { IdCategory = category.IdCategory, Name = category.Name };
    }

    private void CancelEdit()
    {
        ClearMessages();
        form = new Category();
    }

    private async Task DeleteAsync(Category category)
    {
        ClearMessages();
        string question = $"Obrisati kategoriju „{category.Name}”?";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", question);
        if (!confirmed)
            return;

        try
        {
            await CategoryApi.DeleteAsync(category.IdCategory);
            successMessage = $"Kategorija „{category.Name}” je obrisana.";
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    // red koji se trenutno menja je označen žutom bojom
    private string RowClass(Category category)
    {
        return category.IdCategory == form.IdCategory ? "table-warning" : "";
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }
}
