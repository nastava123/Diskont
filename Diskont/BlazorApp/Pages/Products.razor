@page "/products"
@inject ProductApi ProductApi
@inject CategoryApi CategoryApi
@inject IJSRuntime JS

<PageTitle>Proizvodi</PageTitle>

<h1>Proizvodi</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-2 mb-3">
    <div class="col-sm-6 col-lg-4">
        <select class="form-select"
                @bind="selectedCategory" @bind:after="LoadProductsAsync">
            <option value="0">Sve kategorije</option>
            @foreach (Category category in categories)
            {
                <option value="@category.IdCategory">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <a href="products/new" class="btn btn-primary">+ Novi proizvod</a>
    </div>
</div>

@if (products == null)
{
    <p><em>Učitavanje...</em></p>
}
else if (products.Count == 0)
{
    <p>Nema proizvoda u izabranoj kategoriji.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Kategorija</th>
                <th class="text-end">Cena</th>
                <th class="text-end">Na stanju</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Product product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@CategoryName(product.IdCategory)</td>
                    <td class="text-end">@product.Price.ToString("N2") din</td>
                    <td class="text-end">
                        @if (product.Count == 0)
                        {
                            <span class="badge bg-secondary">nema</span>
                        }
                        else
                        {
                            @product.Count
                        }
                    </td>
                    <td class="text-end">
                        <a href="products/edit/@product.IdProduct"
                           class="btn btn-sm btn-outline-primary">Izmeni</a>
                        <button class="btn btn-sm btn-outline-danger ms-1"
                                @onclick="() => DeleteAsync(product)">Obriši</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;
    private List<Category> categories = new List<Category>();
    private int selectedCategory;               // 0 = sve kategorije
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await CategoryApi.GetAllAsync();
            await LoadProductsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Web API nije dostupan. Da li je pokrenut WebApi?";
        }
    }

    private async Task LoadProductsAsync()
    {
        products = null;                        // prikazuje „Učitavanje...”
        int? filter = selectedCategory == 0 ? null : selectedCategory;
        products = await ProductApi.GetAllAsync(filter);
    }

    // proizvod ima samo IdCategory; naziv se traži u već učitanoj listi kategorija
    private string CategoryName(int idCategory)
    {
        Category? category =
            categories.FirstOrDefault(c => c.IdCategory == idCategory);
        return category?.Name ?? "?";
    }

    private async Task DeleteAsync(Product product)
    {
        errorMessage = null;
        string question = $"Obrisati proizvod „{product.Name}”?";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", question);
        if (!confirmed)
            return;

        try
        {
            await ProductApi.DeleteAsync(product.IdProduct);
            await LoadProductsAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }
}
