@page "/products"
@inject HttpClient Http

<h1>Proizvodi</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" placeholder="Naziv" @bind="newProduct.Name" />
    </div>
    <div class="col-md-2">
        <input class="form-control" type="number" placeholder="Cena"
               @bind="newProduct.Price" />
    </div>
    <div class="col-md-2">
        <input class="form-control" type="number" placeholder="Stanje"
               @bind="newProduct.Count" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="newProduct.IdCategory">
            <option value="0">-- kategorija --</option>
            @foreach (Category c in categories)
            {
                <option value="@c.IdCategory">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" @onclick="AddAsync">Dodaj</button>
    </div>
</div>

@if (products == null)
{
    <p>Učitavanje...</p>
}
else
{
    <table class="table">
        <tr>
            <th>Naziv</th>
            <th>Kategorija</th>
            <th>Cena</th>
            <th>Stanje</th>
            <th></th>
        </tr>
        @foreach (Product p in products)
        {
            <tr>
                <td>@p.Name</td>
                <td>@CategoryName(p.IdCategory)</td>
                <td>@p.Price din</td>
                <td>@p.Count</td>
                <td>
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => DeleteAsync(p.IdProduct)">Obriši</button>
                </td>
            </tr>
        }
    </table>
}

@code {
    private List<Product>? products;
    private List<Category> categories = new List<Category>();
    private Product newProduct = new Product();   // polja forme pišu u ovaj objekat
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        categories = await Http.GetFromJsonAsync<List<Category>>("api/categories")
                     ?? new List<Category>();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        products = await Http.GetFromJsonAsync<List<Product>>("api/products");
    }

    // proizvod ima samo IdCategory, pa se naziv traži u listi kategorija
    private string CategoryName(int idCategory)
    {
        Category? c = categories.FirstOrDefault(x => x.IdCategory == idCategory);
        return c?.Name ?? "";
    }

    private async Task AddAsync()
    {
        HttpResponseMessage response =
            await Http.PostAsJsonAsync("api/products", newProduct);
        if (response.IsSuccessStatusCode)
        {
            newProduct = new Product();             // prazna forma
        }
        await HandleResponseAsync(response);
    }

    private async Task DeleteAsync(int id)
    {
        HttpResponseMessage response =
            await Http.DeleteAsync($"api/products/{id}");
        await HandleResponseAsync(response);
    }

    private async Task HandleResponseAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            errorMessage = null;
            await LoadAsync();
        }
        else
        {
            ErrorResponse? error =
                await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = error?.Message;
        }
    }
}
