@page "/products/new"
@page "/products/edit/{Id:int}"
@inject ProductApi ProductApi
@inject CategoryApi CategoryApi
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Novi proizvod" : "Izmena proizvoda")</PageTitle>

<h1>@(IsNew ? "Novi proizvod" : "Izmena proizvoda")</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (product == null)
{
    if (errorMessage == null)
    {
        <p><em>Učitavanje...</em></p>
    }
}
else
{
    <EditForm Model="product" OnSubmit="SaveAsync" style="max-width: 480px">
        <div class="mb-3">
            <label class="form-label">Naziv</label>
            <InputText @bind-Value="product.Name" class="form-control" />
        </div>
        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Cena (din)</label>
                <InputNumber @bind-Value="product.Price" class="form-control" />
            </div>
            <div class="col mb-3">
                <label class="form-label">Na stanju</label>
                <InputNumber @bind-Value="product.Count" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Kategorija</label>
            <InputSelect @bind-Value="product.IdCategory" class="form-select">
                <option value="0">-- izaberite kategoriju --</option>
                @foreach (Category category in categories)
                {
                    <option value="@category.IdCategory">@category.Name</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Sačuvaj</button>
        <a href="products" class="btn btn-outline-secondary ms-1">Nazad</a>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }               // null za /products/new

    private bool IsNew => Id == null;

    private Product? product;
    private List<Category> categories = new List<Category>();
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        categories = await CategoryApi.GetAllAsync();

        if (IsNew)
        {
            product = new Product();
        }
        else
        {
            product = await ProductApi.GetAsync(Id!.Value);
            if (product == null)
                errorMessage = $"Proizvod sa ID {Id} ne postoji.";
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        try
        {
            if (IsNew)
                await ProductApi.AddAsync(product!);
            else
                await ProductApi.UpdateAsync(product!);

            Navigation.NavigateTo("products");  // nazad na listu
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;          // npr. „Cena mora biti veća od nule”
        }
    }
}
